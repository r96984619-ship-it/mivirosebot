# ── Required ─────────────────────────────────────────────────────────────────
# Get from https://my.telegram.org
API_ID=12345678
API_HASH=your_api_hash_here

# Get from @BotFather on Telegram
BOT_TOKEN=your_bot_token_here

# ── Database (optional — bot uses in-memory mock if not set) ─────────────────
# MongoDB connection string, e.g.:  mongodb+srv://user:pass@cluster.mongodb.net
DATABASE_URI=
DATABASE_NAME=Rajappan
COLLECTION_NAME=Telegram_files

# ── Admins & Auth ─────────────────────────────────────────────────────────────
# Space-separated Telegram user IDs of bot admins
ADMINS=123456789

# Channel IDs to auto-index (space-separated, use -100xxxxxxxxxx format)
CHANNELS=-1001234567890

# Optional: force-subscribe channel ID
AUTH_CHANNEL=

# Optional: restrict bot to specific groups (space-separated)
AUTH_GROUP=

# ── Logging ───────────────────────────────────────────────────────────────────
# Channel/group ID where the bot logs events (0 = disabled)
LOG_CHANNEL=0

# Support chat username (without @)
SUPPORT_CHAT=TeamEvamaria

# ── Bot Behaviour ─────────────────────────────────────────────────────────────
# Redirect users to PM instead of sending files in group (True/False)
P_TTI_SHOW_OFF=False

# Show IMDb info on search results (True/False)
IMDB=True

# Show file name + size as a single button instead of two (True/False)
SINGLE_BUTTON=False

# Custom caption for files ("{file_name}", "{file_size}", "{file_caption}" are supported)
CUSTOM_FILE_CAPTION=

# Show full IMDb description (True/False)
LONG_IMDB_DESCRIPTION=False

# Suggest spelling corrections when no results found (True/False)
SPELL_CHECK_REPLY=True

# Limit length of cast/crew lists (leave blank for no limit)
MAX_LIST_ELM=

# Protect file content from forwarding (True/False)
PROTECT_CONTENT=False

# Allow public link generation (True/False)
PUBLIC_FILE_STORE=True

# Channel IDs used for file store (space-separated)
FILE_STORE_CHANNEL=

# ── Session ───────────────────────────────────────────────────────────────────
SESSION=Media_search

# Cache time for inline results (seconds)
CACHE_TIME=300
