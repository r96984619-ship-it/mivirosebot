# ── REQUIRED ─────────────────────────────────────────────────────────────────
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:your_bot_token_here

# ── DATABASE ──────────────────────────────────────────────────────────────────
# Leave empty to use in-memory store (data resets on restart)
DATABASE_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=Cluster0
DATABASE_NAME=Rajappan

# ── ADMINS & CHANNELS ────────────────────────────────────────────────────────
ADMINS=123456789 987654321
CHANNELS=-1001234567890
LOG_CHANNEL=-1001234567890

# ── FORCE SUBSCRIBE (up to 3 channels) ───────────────────────────────────────
AUTH_CHANNEL=-1001234567890
FSUB_2=-1001234567891
FSUB_3=-1001234567892

# ── SHORTLINK MONETIZATION (up to 3 providers) ───────────────────────────────
SHORTLINK_URL=api.shareus.io
SHORTLINK_API=your_api_key
SHORTLINK_URL2=
SHORTLINK_API2=
SHORTLINK_URL3=
SHORTLINK_API3=

# Verification settings
VERIFY_DAILY_LIMIT=1
VERIFY_EXPIRE=86400
VERIFY_TUTORIAL=
VERIFY_TUTORIAL2=
VERIFY_TUTORIAL3=

# ── PREMIUM ───────────────────────────────────────────────────────────────────
SUB_LINK=https://t.me/yourchannel
PREMIUM_PASS=

# ── GROUP & SUPPORT ───────────────────────────────────────────────────────────
MOVIE_GROUP=https://t.me/+yourgroup
SUPPORT_CHAT=yoursupport

# ── FEATURE TOGGLES ───────────────────────────────────────────────────────────
IMDB=True
SINGLE_BUTTON=False
PROTECT_CONTENT=False
SPELL_CHECK_REPLY=True
P_TTI_SHOW_OFF=False
MELCOW_NEW_USERS=True
LONG_IMDB_DESCRIPTION=False

# ── OPTIONAL ─────────────────────────────────────────────────────────────────
CUSTOM_FILE_CAPTION=
AUTH_CHANNEL=
AUTH_GROUP=
FILE_STORE_CHANNEL=
PUBLIC_FILE_STORE=True
